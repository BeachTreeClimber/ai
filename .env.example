# Copy to `.env` for local Vite dev (client-side, prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the AI chat API lives. Defaults to /api/chat (Cloudflare Pages Functions).
# On GitHub Pages the API is a separate Cloudflare Worker:
# VITE_API_URL=https://ai-chat-api.lachlanhenryhumphreys.workers.dev

# Base path of the site. Defaults to /. For GitHub Pages project sites this is
# /<repo-name>/ (e.g. /ai/ for this repo):
# VITE_BASE_URL=/ai/
